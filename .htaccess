# Pengaman untuk shared hosting yang document root-nya tidak bisa diarahkan ke public/.
# Semua permintaan dialihkan ke public/, sehingga database/, storage/, .env, dan
# vendor/ tidak pernah bisa diakses langsung lewat URL.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "(^\.|\.(sqlite|sqlite-wal|sqlite-shm|db|env|log|sql|bak)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
